{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "PTIT: Chạy website",
      "type": "process",
      "command": "python3",
      "windows": {
        "command": "${env:USERPROFILE}/.cache/codex-runtimes/codex-primary-runtime/dependencies/python/python.exe"
      },
      "args": ["-u", "-m", "http.server", "8765", "--bind", "127.0.0.1", "--directory", "dist"],
      "options": { "cwd": "${workspaceFolder}" },
      "isBackground": true,
      "problemMatcher": {
        "owner": "ptit-preview",
        "pattern": {
          "regexp": "^(.+):(\\d+):(\\d+): (error|warning): (.+)$",
          "file": 1,
          "line": 2,
          "column": 3,
          "severity": 4,
          "message": 5
        },
        "background": {
          "activeOnStart": true,
          "beginsPattern": "^Serving HTTP on",
          "endsPattern": "^Serving HTTP on"
        }
      },
      "group": { "kind": "build", "isDefault": true },
      "presentation": { "reveal": "always", "panel": "dedicated" },
      "runOptions": { "instanceLimit": 1 }
    }
  ]
}
